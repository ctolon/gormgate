# Django on the reference interpreter for gormgate's CLI parity tests.
#
# The versions are pinned by default and overridable as build arguments, so
# that the weekly drift canary can build the same image against the latest
# releases without a second Dockerfile. The pins matter:
# internal/argparse/testdata is generated by this interpreter's argparse,
# and CPython has changed message wording within a minor series before.
ARG PYTHON_VERSION=3.14.7
FROM python:${PYTHON_VERSION}-slim

# psycopg is here because the parity project runs on the PostgreSQL server
# itest/compose.yaml starts, which is what makes the SQL both sides print
# comparable statement for statement.
ARG DJANGO_VERSION=6.0.8
ARG PSYCOPG_VERSION=3.3.6
RUN pip install --no-cache-dir "Django==${DJANGO_VERSION}" "psycopg[binary]==${PSYCOPG_VERSION}"

WORKDIR /proj
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TZ=UTC COLUMNS=80
